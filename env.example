# Copy this file to "env.txt" (or ".env") and fill in your own values.
# Never commit env.txt. It is listed in .gitignore.
# このファイルを env.txt という名前でコピーして値を入れてください（GitHubには出さないこと）。

# PayPal REST app credentials (Sandbox) — developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email of a Sandbox *Personal* account. Invoices are sent here.
# Leave empty to only create invoice drafts.
BUYER_EMAIL=

CURRENCY=USD

# Google AI Studio key (free tier works) — aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
